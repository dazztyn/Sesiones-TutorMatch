<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- El "parent" de Spring Boot fija versiones compatibles entre sí de todas las librerías
         (Hibernate, Flyway, driver de Postgres, Jackson...). Por eso abajo casi ninguna
         dependencia declara <version>. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>cl.tutorias</groupId>
    <artifactId>sesiones</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>sesiones</name>
    <description>Servicio de Sesiones de la plataforma de tutorías</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Servidor HTTP embebido (Tomcat). Por ahora solo sirve los endpoints de Actuator
             (/actuator/health); la API real del servicio será gRPC. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Health checks y métricas. Kubernetes usará /actuator/health para las probes. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate: mapeo de tablas a clases y repositorios. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway: aplica las migraciones SQL de src/main/resources/db/migration al arrancar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Driver JDBC de PostgreSQL (solo se necesita en tiempo de ejecución). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Servidor gRPC (Netty, puerto 9090): la API real del servicio. Incluye reflexión,
             así que grpcurl puede listar los RPC sin tener el .proto. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-server</artifactId>
        </dependency>

        <!-- Cliente gRPC: Sesiones llama a Usuarios.ValidarTutorRamo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-client</artifactId>
        </dependency>

        <!-- Spring Kafka: productor de los eventos sesion.creada, sesion.finalizada y
             sesion.cancelada que consume el servicio de Material. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Solo para desarrollo local: al hacer spring-boot:run levanta compose.yaml
             (Postgres y Kafka) y configura la conexión automáticamente. No se empaqueta en el jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Tests de integración contra Postgres y Kafka reales en contenedores (necesitan Docker). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/contracts/proto/sesiones/v1</sourceDirectory>
                        <sourceDirectory>${project.basedir}/contracts/proto/usuarios/v1</sourceDirectory>
                    </sourceDirectories>
                </configuration>
            </plugin>

            <!-- Coverage: "./mvnw verify" falla si los tests cubren menos del 60% de las líneas.
                 El informe queda en target/site/jacoco/index.html. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <configuration>
                    <!-- Clases generadas desde los .proto: no son código nuestro. Comparten paquete con
                         SesionesGrpcService, por eso se nombran una por una (si el contrato agrega un
                         mensaje que no termine en Request ni Response, hay que sumarlo aquí). -->
                    <excludes>
                        <exclude>cl/tutorias/usuarios/grpc/**</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/*Request*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/*Response*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/*OrBuilder*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/Sesion.class</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/Sesion$*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/Sesiones.class</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/Sesiones$*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/SesionesServiceGrpc*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/BloqueDisponibilidad*</exclude>
                        <exclude>cl/tutorias/sesiones/grpc/EstadoSesion*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Permite "./mvnw spring-boot:run" y empaqueta un jar ejecutable. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
